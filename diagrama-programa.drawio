<mxfile host="app.diagrams.net" agent="Cursor" version="24.0.0">
  <diagram name="Sistema de incidentes" id="diagrama-simple">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="titulo" value="Sistema de gestión de incidentes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="520" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="inicio" value="Inicio del programa" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="80" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ejemplos" value="Se cargan 3 tickets de ejemplo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="450" y="170" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="menu" value="Menú principal&#xa;&#xa;1. Crear ticket&#xa;2. Ver tickets&#xa;3. Cambiar estado&#xa;4. Salir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="250" width="300" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="decision" value="¿Qué opción&#xa;eliges?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="390" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="crear" value="1. Crear ticket&#xa;&#xa;Pides:&#xa;• Título&#xa;• Descripción&#xa;• Quién lo reportó&#xa;• Prioridad (alta/media/baja)&#xa;&#xa;El ticket empieza como &quot;abierto&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="240" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="ver" value="2. Ver tickets&#xa;&#xa;Muestra todos los tickets&#xa;ordenados por prioridad:&#xa;primero alta, luego media,&#xa;luego baja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="540" width="240" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="modificar" value="3. Cambiar estado&#xa;&#xa;Pides el ID del ticket&#xa;&#xa;Si no existe → error&#xa;Si existe → pides el nuevo estado&#xa;(abierto / progreso / resuelto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="540" width="260" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="salir" value="4. Salir&#xa;&#xa;Cierra el programa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1">
          <mxGeometry x="920" y="560" width="180" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="lista" value="Todos los tickets se guardan&#xa;en una lista en memoria" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="730" width="300" height="80" as="geometry"/>
